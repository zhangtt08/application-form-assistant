{
  "name": "application-form-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "网申自动填写助手：Scan -> Recognize -> Match -> Risk Check -> Preview -> Human Confirm -> Fill",
  "type": "module",
  "scripts": {
    "build": "npm run build:sidepanel && npm run build:content && npm run build:background",
    "build:sidepanel": "vite build --mode sidepanel",
    "build:content": "vite build --mode content",
    "build:background": "vite build --mode background",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "eval:generation": "vitest run --config vitest.eval.config.ts",
    "test:compat": "playwright test e2e/compat/",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "agent:serve": "node agent/server.mjs",
    "agent:mcp": "node agent/mcp-server.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
